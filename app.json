{
  "expo": {
    "name": "Danabol",
    "slug": "danabol-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/danabol-app-icon.png",
    "scheme": "danabolmobile",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/danabol-app-icon.png",
      "bundleIdentifier": "com.danabol.mobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.danabol.mobile",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/danabol-app-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#080e15",
          "image": "./assets/images/danabol-splash.png",
          "imageWidth": 94
        }
      ],
      "expo-font",
      "expo-image",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/danabol-notification-icon.png",
          "color": "#8ec0ed"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "5c081267-7f03-4c8f-a26d-30a5a23e49be"
      }
    }
  }
}
